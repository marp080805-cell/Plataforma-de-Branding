# ============================================================
# BrandMind — Configuração de Ambiente
# ============================================================
# O script setup.sh preenche este arquivo automaticamente.
# Preencha manualmente apenas se não usar o setup.sh.

# ------------------------------------------------------------
# BANCO DE DADOS (Supabase)
# Painel Supabase → Connect → Connection String
#
# DATABASE_URL: Transaction Pooler (porta 6543) — IPv4, para a app
# DIRECT_URL:   Session Pooler (porta 5432)     — IPv4, para migrations
#
# IMPORTANTE: Use sempre o pooler (pooler.supabase.com), nunca a
# conexão direta (db.PROJECT.supabase.co) pois ela é IPv6-only.
# O usuário do pooler inclui o project-ref: postgres.PROJECT-REF
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"
# DIRECT_URL: Session Pooler (porta 5432) — obrigatório para migrations.
# O Transaction Pooler (DATABASE_URL) não suporta os comandos do Prisma migrate.

# ------------------------------------------------------------
# NEXTAUTH
# NEXTAUTH_SECRET: rode `openssl rand -base64 32` para gerar
# NEXTAUTH_URL: URL pública da sua aplicação (sem barra no final)
# ------------------------------------------------------------
NEXTAUTH_SECRET="cole_aqui_um_secret_seguro_gerado_com_openssl"
NEXTAUTH_URL="https://seudominio.com.br"

# ------------------------------------------------------------
# ENCRIPTAÇÃO DAS API KEYS
# Gere com: openssl rand -hex 32
# IMPORTANTE: Guarde em lugar seguro! Se perder, as API keys
# salvas no banco ficam inacessíveis.
# ------------------------------------------------------------
ENCRYPTION_KEY="cole_aqui_64_caracteres_hexadecimais_gerados_com_openssl"

# ------------------------------------------------------------
# EMAIL (para recuperação de senha)
# Suporte a qualquer provedor SMTP (Gmail, Brevo, Mailgun, etc.)
#
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#        Use uma "Senha de app" em: myaccount.google.com/apppasswords
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# ------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="sua_senha_de_app"
SMTP_FROM="BrandMind <seuemail@gmail.com>"

# ------------------------------------------------------------
# AMBIENTE
# ------------------------------------------------------------
NODE_ENV=production
