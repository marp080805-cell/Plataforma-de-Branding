# ============================================================
# BrandForge — Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores

# ------------------------------------------------------------
# BANCO DE DADOS (Supabase)
# Pegue no painel do Supabase: Settings > Database > Connection string
# Use a URL do Transaction Pooler (porta 6543) para DATABASE_URL
# Use a URL Session/Direct (porta 5432) para DIRECT_URL
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.supabase.com:5432/postgres"

# ------------------------------------------------------------
# NEXTAUTH
# NEXTAUTH_SECRET: rode `openssl rand -base64 32` para gerar
# NEXTAUTH_URL: URL pública da sua aplicação (com https://)
# ------------------------------------------------------------
NEXTAUTH_SECRET="cole_aqui_um_secret_seguro_gerado_com_openssl"
NEXTAUTH_URL="https://seudominio.com.br"

# ------------------------------------------------------------
# ENCRIPTAÇÃO DAS API KEYS
# Gere com: openssl rand -hex 32
# IMPORTANTE: Guarde em lugar seguro! Se perder, as API keys
# salvas no banco ficam inacessíveis.
# ------------------------------------------------------------
ENCRYPTION_KEY="cole_aqui_64_caracteres_hexadecimais_gerados_com_openssl"

# ------------------------------------------------------------
# AMBIENTE
# ------------------------------------------------------------
NODE_ENV=production
